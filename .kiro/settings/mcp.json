      "command": "kirograph",
      "args": [
        "serve",
        "--mcp",
        "--path",
        "D:/Dev/Contacts App/codegen"
      ]
    },
    "kirograph-jobcrm": {
      "command": "kirograph",
      "args": [
        "serve",
        "--mcp",
