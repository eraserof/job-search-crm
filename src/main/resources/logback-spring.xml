<?xml version="1.0" encoding="UTF-8"?>
<!--
  Logging configuration (development-guidelines.md § Logging Conventions).

  - Console appender for interactive CLI use (WARN+ by default so normal command
    output isn't drowned; com.jobcrm at INFO).
  - Rolling file appender under ~/.jobcrm/logs/, rotated daily, so the AgentRun
    audit trail has a durable companion.
  - The pattern surfaces the conventional MDC keys (agentRunId, agentName,
    opportunityId, interactionId) when present, via %X.
-->
<configuration>

  <property name="LOG_DIR" value="${user.home}/.jobcrm/logs"/>

  <!-- %mdc prints all set MDC pairs as k=v, comma-separated; empty when none set. -->
  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <target>System.err</target>
    <encoder>
      <pattern>%d{HH:mm:ss.SSS} %-5level %logger{20} %mdc %msg%n</pattern>
    </encoder>
  </appender>

  <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <file>${LOG_DIR}/jobcrm.log</file>
    <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
      <fileNamePattern>${LOG_DIR}/jobcrm.%d{yyyy-MM-dd}.log</fileNamePattern>
      <maxHistory>30</maxHistory>
      <totalSizeCap>100MB</totalSizeCap>
    </rollingPolicy>
    <encoder>
      <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger %mdc %msg%n</pattern>
    </encoder>
  </appender>

  <root level="WARN">
    <appender-ref ref="CONSOLE"/>
    <appender-ref ref="FILE"/>
  </root>

  <logger name="com.jobcrm" level="INFO"/>

</configuration>
