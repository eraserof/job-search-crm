# Gradle
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar
!**/src/**/build/
!**/src/**/.gradle/

# Java build artifacts
*.class
*.jar
*.war
*.ear
*.nar
hs_err_pid*
replay_pid*

# IDEs
.idea/
*.iml
*.ipr
*.iws
.vscode/
.settings/
.project
.classpath
.factorypath
bin/
out/

# OS
.DS_Store
Thumbs.db
desktop.ini

# Local runtime data (user data lives under ~/.jobcrm/, never in the repo)
.jobcrm/
jobcrm.db
jobcrm.db-*
*.sqlite
*.sqlite-*

# Logs
logs/
*.log

# Env / secrets — never commit
.env
.env.*
!.env.example
application-local.yml
application-local.yaml
application-secrets.yml
application-secrets.yaml
*.pem
*.key

# Test fixtures that record real API responses may contain sensitive data;
# recorded LLM fixtures are opt-in and reviewed before commit
src/test/resources/fixtures/agents/**/*.private.json
